{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MZ Video Downloader",
  "version": "0.3.0",
  "identifier": "com.mzmd.videodownloader",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MZ Video Downloader",
        "width": 1000,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../bin/yt-dlp.exe": "yt-dlp.exe",
      "../bin/ffmpeg.exe": "ffmpeg.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
"windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
